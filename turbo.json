{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "inputs": [
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"]
    },
    "lint": {
      "dependsOn": ["codegen"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["codegen"],
      "cache": false,
      "persistent": true
    },
    "//#cargo:check": {
      "cache": false
    },
    "//#cargo:test": {
      "cache": false
    }
  }
}
