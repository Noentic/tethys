# Set default behavior to automatically normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare text file formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# Explicitly declare binary file formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.db binary
*.db-wal binary
*.db-shm binary
